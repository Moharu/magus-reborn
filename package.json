{
    "name": "magus-reborn",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev:web": "npm run dev -w @magus/web",
        "dev:server": "npm run dev -w @magus/server",
        "sim:search": "npm run sim:search -w @magus/engine --",
        "build": "npm run build -w @magus/web",
        "deploy:server": "npm run deploy -w @magus/server",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "workerd@1.20261103.1": true
    }
}
